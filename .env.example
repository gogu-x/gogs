# Copy to .env and replace every CHANGE_ME value with a strong secret.
MONGO_ROOT_USERNAME=game_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_JWT_SECRET
GCONF_DB=gs_conf_dev

# Image label and host ports.
APP_IMAGE_TAG=v1
GATE_PORT=8081
PLATFORM_WEBHOOK_PORT=7001

  docker run -d \
    --name gate-1 \
    --network gogu-net
    --restart unless-stopped \
    -p 8001:8001 \
    gogs-gate:v1001-2\
    --gate-id 1 \
    --node-id 1 \
    --gate-base-port 8000 \
    --etcd 127.0.0.1:2379 \
    --nats-url nats://nats:4222 \
    --platform-grpc-addr 127.0.0.1:7000


      docker run -d \
        --name game-1 \
        --network gogu-net \
        --restart unless-stopped \
        -p 9001:9001 \
        gogs-game:v1001-3 \
        --server-id 1 \
        --node-id 1 \
        --etcd 127.0.0.1:2379 \
        --nats-url nats://nats:4222 \
        --mongo-url mongodb://172.17.0.1:27018 \
        --mongo-username admin \
        --mongo-password asd620522- \
        --platform-grpc-addr 127.0.0.1:7000 \
        --gconf-db-uri mongodb://admin:asd620522-@172.17.0.1:27018/?authSource=admin \
        --gconf-db gs_conf_g1_dev

      docker run -d \
        --name platform-1 \
        --network gogu-net \
        --restart unless-stopped \
        -p 7000:7000 \
        -p 7001:7001 \
        gogs-platform:v1001-2 \
        --server-id 1 \
        --node-id 1 \
        --etcd etcd:2379 \
        --nats-url nats://nats:4222 \
        --mongo-url mongodb://172.17.0.1:27018 \
        --mongo-username admin \
        --mongo-password asd620522- \


 docker run -d \
        --name battle-1 \

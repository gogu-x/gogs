MONGO_ROOT_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_JWT_SECRET
GCONF_DB=gs_conf_dev

# Image label and host ports.
APP_IMAGE_TAG=v1
GATE_PORT=8081
PLATFORM_WEBHOOK_PORT=7001

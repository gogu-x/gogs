        --restart unless-stopped \
        gogs-battle:v1001-4 \
        --server-id 1 \
        --node-id 1 \
        --etcd etcd:2379 \
        --nats-url nats://nats:4222 \
        --mongo-url mongodb://172.17.0.1:27018 \
        --mongo-username admin \
        --mongo-password asd620522- \
        --platform-grpc-addr 127.0.0.1:7000 \
        --gconf-db-uri mongodb://admin:asd620522-@172.17.0.1:27018/?authSource=admin \
